# Application
APP_NAME="dpk_pvt_csbk"
APP_ENV=local                                       # local | production
APP_DEBUG=true                                      # true shows detailed errors (disable in production)
APP_URL=http://localhost/dpk_pvt_csbk
APP_KEY=base64:CHANGE_ME_TO_A_LONG_RANDOM_STRING
APP_TIMEZONE=Asia/Kolkata

# Database (MySQL via PDO)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_dpk_pvt_csbk
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Session
SESSION_NAME=DPK_PVT_CSBK_SESSID
SESSION_LIFETIME=120                            # in minutes
SESSION_SECURE=false                            # set true when serving over HTTPS
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

# Security
CSRF_TOKEN_NAME=_csrf
BCRYPT_COST=12
