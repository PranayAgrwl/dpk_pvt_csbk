# Application
APP_NAME="dpk_pvt_csbk"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/dpk_pvt_csbk
APP_KEY=base64:CHANGE_ME_TO_A_LONG_RANDOM_STRING
# php -r "echo 'base64:' . base64_encode(random_bytes(32)) . PHP_EOL;"
APP_TIMEZONE=Asia/Kolkata

# Database (MySQL via PDO)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_dpk_pvt_csbk
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Session
SESSION_NAME=DPK_PVT_CSBK_SESSID
SESSION_LIFETIME=120
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

# Security
CSRF_TOKEN_NAME=_csrf
BCRYPT_COST=12
