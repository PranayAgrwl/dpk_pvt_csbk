# =============================================================================
# public/.htaccess
# Front-controller rewrite: anything that isn't a real file/dir goes through
# index.php, which dispatches to the Router (Laravel-style clean URLs).
# =============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Allow direct access to existing static files (CSS/JS/images, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Send everything else to index.php (front controller).
    RewriteRule ^ index.php [L]
</IfModule>

# Disable directory listing
Options -Indexes

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>
